    {
        *Name: "Statement-R"
        *PageDimensions: PAIR(5100, 3300)
        *PrintableArea: PAIR(4958, 3134)
        *PrintableOrigin: PAIR(71, 118)
        *CursorOrigin: PAIR(71, 118)  
    }
}
*Feature: ColorMode
{
    *rcNameID: =COLOR_PRINTING_MODE_DISPLAY
    *DefaultOption: 24bpp
    *Option: 24bpp
    {
        *rcNameID: =24BPP_DISPLAY
        *DevNumOfPlanes: 1
        *DevBPP: 24
        *DrvBPP: 24
        *PaletteSize: 1
        *RasterMode: DIRECT
        *Command: CmdSelect
        {
            *Order: PAGE_SETUP.16
            *CallbackID: 1
        }
    }
}
*Feature: Halftone
{
    *rcNameID: =HALFTONING_DISPLAY
    *DefaultOption: HT_PATSIZE_8x8_M
    *Option: HT_PATSIZE_AUTO
    {
        *rcNameID: =HT_AUTO_SELECT_DISPLAY
    }
    *Option: HT_PATSIZE_SUPERCELL_M
    {
        *rcNameID: =HT_SUPERCELL_DISPLAY
    }
    *Option: HT_PATSIZE_6x6_M
    {
        *rcNameID: =HT_DITHER6X6_DISPLAY
    }
    *Option: HT_PATSIZE_8x8_M
    {
        *rcNameID: =HT_DITHER8X8_DISPLAY
    }
}
*Command: CmdStartDoc
{
    *Order: DOC_SETUP.5
    *CallbackID: 1
}
*Command: CmdStartPage
{
    *Order: PAGE_SETUP.1
    *CallbackID: 1
}
*Command: CmdEndJob
{
    *Order: JOB_FINISH.1
    *CallbackID: 1
}
*TextCaps: LIST(TC_UA_ABLE)
*Command: CmdCR { *CallbackID: 1 }
*Command: CmdLF { *CallbackID: 1 }
*Command: CmdFF { *CallbackID: 1 }
*EjectPageWithFF?: TRUE
*RasterSendAllData?: TRUE